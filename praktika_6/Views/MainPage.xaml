<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:praktika_6.Models"
             xmlns:viewmodels="clr-namespace:praktika_6.ViewModels"
             xmlns:resources="clr-namespace:praktika_6.Resources.Localization"
             x:Class="praktika_6.Views.MainPage"
             Title="{x:Static resources:AppResources.PageTitle}"> 
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Keel / Language" Command="{Binding ChangeLanguageCommand}" />
    </ContentPage.ToolbarItems>
    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="20">
            
            
            <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                <Button Text="&lt;" Command="{Binding PreviousDayCommand}" />
                <Label Text="{Binding SelectedDate, StringFormat='{0:dd.MM.yyyy}'}" 
                       VerticalTextAlignment="Center" FontSize="18" FontAttributes="Bold" />
                <Button Text="&gt;" Command="{Binding NextDayCommand}" />
            </HorizontalStackLayout>

            <Border BackgroundColor="{AppThemeBinding Light=#E0F2FE, Dark=#03346E}" Padding="15">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="5">
                    <Label Text="{x:Static resources:AppResources.TotalDailyCalories}"
                           FontSize="14" HorizontalOptions="Center"/> 
                    <Label Text="{Binding TotalDailyCalories, StringFormat='{0} kcal'}" 
                           FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- BREAKFAST -->
            <Border Padding="10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static resources:AppResources.Breakfast}"
                           FontAttributes="Bold" FontSize="16" />
                    
                    <!-- Entry fields -->
                    <Grid ColumnDefinitions="*, 80, Auto, Auto" ColumnSpacing="6" VerticalOptions="Center">
                        <Entry Grid.Column="0" Placeholder="{x:Static resources:AppResources.FoodPlaceholder}"
                               Text="{Binding BreakfastFood}" />
                        <Entry Grid.Column="1" Text="{Binding BreakfastAmount}" Keyboard="Numeric" />
                        <Label Grid.Column="2" Text="g" VerticalTextAlignment="Center" Margin="2,0,4,0" />
            
                        <Button Grid.Column="3" Text="+" 
                                Command="{Binding AddMealCommand}" 
                                CommandParameter="{x:Static models:MealType.Breakfast}" />
                    </Grid>
                    
                    <!-- Saved entries -->
                    <CollectionView ItemsSource="{Binding BreakfastMeals}" HeightRequest="100">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItem Text="{x:Static resources:AppResources.Delete}"
                                                   BackgroundColor="Red" 
                                                   Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, 
                                                   Path=BindingContext.DeleteMealCommand}" 
                                                   CommandParameter="{Binding .}" />
                                    </SwipeView.RightItems>
                                    <HorizontalStackLayout Spacing="10" Padding="5">
                                        <Label Text="{Binding FoodName}" FontAttributes="Bold" />
                                        <Label Text="{Binding AmountGrams, StringFormat='{0}g'}" />
                                        <Label Text="{Binding TotalCalories, StringFormat='- {0} kcal'}" />
                                    </HorizontalStackLayout>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- LUNCH -->
            <Border Padding="10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static resources:AppResources.Lunch}" 
                           FontAttributes="Bold" FontSize="16" />
                    
                    <!-- Entry fields -->
                    <Grid ColumnDefinitions="*, 80, Auto, Auto" ColumnSpacing="6" VerticalOptions="Center">
                        <Entry Grid.Column="0" 
                               Placeholder="{x:Static resources:AppResources.FoodPlaceholder}" 
                               Text="{Binding LunchFood}" />
                        <Entry Grid.Column="1" Text="{Binding LunchAmount}" Keyboard="Numeric" />
                        <Label Grid.Column="2" Text="g" VerticalTextAlignment="Center" Margin="2,0,4,0" />
                        
                        <Button Grid.Column="3" Text="+" 
                                Command="{Binding AddMealCommand}" 
                                CommandParameter="{x:Static models:MealType.Lunch}" />
                    </Grid>
                    
                    <!-- Saved entries -->
                    <CollectionView ItemsSource="{Binding LunchMeals}" HeightRequest="100">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItem Text="{x:Static resources:AppResources.Delete}"
                                                   BackgroundColor="Red" 
                                                   Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, 
                                                   Path=BindingContext.DeleteMealCommand}" 
                                                   CommandParameter="{Binding .}" />
                                    </SwipeView.RightItems>
                                    
                                    <HorizontalStackLayout Spacing="10" Padding="5">
                                        <Label Text="{Binding FoodName}" FontAttributes="Bold" />
                                        <Label Text="{Binding AmountGrams, StringFormat='{0}g'}" />
                                        <Label Text="{Binding TotalCalories, StringFormat='- {0} kcal'}" />
                                    </HorizontalStackLayout>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- DINNER -->
            <Border Padding="10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static resources:AppResources.Dinner}" 
                           FontAttributes="Bold" FontSize="16" />
                    
                    <!-- Entry fields -->
                    <Grid ColumnDefinitions="*, 80, Auto, Auto" ColumnSpacing="6" VerticalOptions="Center">
                        <Entry Grid.Column="0" 
                               Placeholder="{x:Static resources:AppResources.FoodPlaceholder}" 
                               Text="{Binding DinnerFood}" />
                        <Entry Grid.Column="1" Text="{Binding DinnerAmount}" Keyboard="Numeric" />
                        <Label Grid.Column="2" Text="g" VerticalTextAlignment="Center" Margin="2,0,4,0" />
                        
                        <Button Grid.Column="3" Text="+" 
                                Command="{Binding AddMealCommand}" 
                                CommandParameter="{x:Static models:MealType.Dinner}" />
                    </Grid>
                    
                    <!-- Saved entries -->
                    <CollectionView ItemsSource="{Binding DinnerMeals}" HeightRequest="100">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItem Text="{x:Static resources:AppResources.Delete}" 
                                                   BackgroundColor="Red" 
                                                   Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                   Path=BindingContext.DeleteMealCommand}" 
                                                   CommandParameter="{Binding .}" />
                                    </SwipeView.RightItems>
                                    <HorizontalStackLayout Spacing="10" Padding="5">
                                        <Label Text="{Binding FoodName}" FontAttributes="Bold" />
                                        <Label Text="{Binding AmountGrams, StringFormat='{0}g'}" />
                                        <Label Text="{Binding TotalCalories, StringFormat='- {0} kcal'}" />
                                    </HorizontalStackLayout>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>