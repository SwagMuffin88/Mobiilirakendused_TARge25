<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:praktika_4.ViewModels"
             xmlns:localization="clr-namespace:praktika_4.Resources.Localization"
             x:Class="praktika_4.MainPage"
             Title="{x:Static localization:AppResources.AppTitle}">

    <ContentPage.BindingContext>
        <viewModels:MainViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#800020" Offset="0.0" />
            <GradientStop Color="#1C1C1C" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, *, Auto, Auto" Padding="20" RowSpacing="15">
        <Button Grid.Row="0"
                Text="{x:Static localization:AppResources.LanguageSwitch}"
                Command="{Binding SwitchLanguageCommand}"
                HorizontalOptions="End"
                BackgroundColor="#50FFFFFF"
                TextColor="White"
                CornerRadius="15"
                Padding="12" />

        <CarouselView Grid.Row="1"
                      x:Name="dishesCarousel"
                      ItemsSource="{Binding Dishes}"
                      Position="{Binding Position, Mode=TwoWay}"
                      IndicatorView="indicatorView"
                      Loop="True">
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10">
                        <Border Padding="0"
                                BackgroundColor="#2B2B2B"
                                Stroke="Transparent">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>

                            <Border.Shadow>
                                <Shadow Brush="Black"
                                        Offset="0,4"
                                        Radius="10"
                                        Opacity="0.3" />
                            </Border.Shadow>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDishTapped" />
                            </Border.GestureRecognizers>

                            <Grid RowDefinitions="2*, 1*">
                                <Image Grid.Row="0"
                                       Source="{Binding ImageUrl}"
                                       Aspect="AspectFill" />

                                <StackLayout Grid.Row="1" Padding="15" Spacing="8">
                                    <Label Text="{Binding Name}"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="White" />

                                    <Label Text="{Binding ShortDescription}"
                                           FontSize="14"
                                           TextColor="#DDD"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation" />
                                </StackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <IndicatorView Grid.Row="2"
                       x:Name="indicatorView"
                       IndicatorColor="#77FFFFFF"
                       SelectedIndicatorColor="#FFD700"
                       HorizontalOptions="Center"
                       Margin="0,10" />

        <Label Grid.Row="3"
               Text=""
               TextColor="#AAFFFFFF"
               FontSize="12"
               HorizontalOptions="Center" />
    </Grid>
</ContentPage>