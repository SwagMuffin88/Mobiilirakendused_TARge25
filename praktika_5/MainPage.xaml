<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="praktika_5.MainPage"
             BackgroundColor="{DynamicResource ThemeBackgroundColor}">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="ThemeBackgroundColor">White</Color>
            <Color x:Key="ThemeTextColor">Black</Color>
            <Color x:Key="ThemeAccentColor">RoyalBlue</Color>
            <Color x:Key="ThemeGridBackgroundColor">LightGray</Color>
            <x:String x:Key="ThemeFontFamily">OpenSansRegular</x:String>
        </ResourceDictionary>
    </ContentPage.Resources>

    <VerticalStackLayout Spacing="20" Padding="20" VerticalOptions="Center" HorizontalOptions="Center">
        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
            <Label Text="Mängija:" 
                   TextColor="{DynamicResource ThemeTextColor}" 
                   FontFamily="{DynamicResource ThemeFontFamily}" 
                   FontSize="18"/>
            <Label x:Name="PlayerNameLabel" 
                   TextColor="{DynamicResource ThemeTextColor}" 
                   FontFamily="{DynamicResource ThemeFontFamily}" 
                   FontSize="18" 
                   FontAttributes="Bold"/>
            
            <Label Text="Skoor:" 
                   TextColor="{DynamicResource ThemeTextColor}" 
                   FontFamily="{DynamicResource ThemeFontFamily}" 
                   FontSize="18" 
                   Margin="20,0,0,0"/>
            <Label x:Name="ScoreLabel" 
                   Text="0" 
                   TextColor="{DynamicResource ThemeTextColor}" 
                   FontFamily="{DynamicResource ThemeFontFamily}" 
                   FontSize="18" 
                   FontAttributes="Bold"/>
        </HorizontalStackLayout>
        
        <HorizontalStackLayout Spacing="15" HorizontalOptions="Center" Margin="0,10,0,0">
            <Button Text="Hele" 
                    Clicked="OnLightThemeClicked"
                    BackgroundColor="#F0F0F0"
                    TextColor="#333333"
                    FontFamily="{DynamicResource ThemeFontFamily}"
                    CornerRadius="8"
                    Padding="15,8"/>

            <Button Text="Tume" 
                    Clicked="OnDarkThemeClicked"
                    BackgroundColor="#2D2D2D"
                    TextColor="#FFFFFF"
                    FontFamily="{DynamicResource ThemeFontFamily}"
                    CornerRadius="8"
                    Padding="15,8"/>

            <Button Text="Värviline" 
                    Clicked="OnColorThemeClicked"
                    BackgroundColor="{DynamicResource ThemeAccentColor}"
                    TextColor="#FFFFFF"
                    FontFamily="{DynamicResource ThemeFontFamily}"
                    CornerRadius="8"
                    Padding="15,8"/>
        </HorizontalStackLayout>

        <Border BackgroundColor="{DynamicResource ThemeGridBackgroundColor}" 
                Padding="10" 
                StrokeShape="RoundRectangle 10"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Grid x:Name="GameGrid" RowSpacing="5" ColumnSpacing="5" />
        </Border>

        <Button x:Name="NewGameButton"
                Text="Uus mäng" 
                Clicked="OnNewGameClicked"
                BackgroundColor="{DynamicResource ThemeAccentColor}"
                TextColor="#FFFFFF"
                FontFamily="{DynamicResource ThemeFontFamily}"
                HorizontalOptions="Center" />

    </VerticalStackLayout>
</ContentPage>