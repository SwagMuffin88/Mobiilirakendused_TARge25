<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="praktika_5.MainPage"
             BackgroundColor="{DynamicResource ThemeBackgroundColor}">

    <VerticalStackLayout Spacing="20" Padding="20" VerticalOptions="Center" HorizontalOptions="Center">
        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
            <Label Text="Mängija:" 
                   TextColor="{DynamicResource ThemeTextColor}" 
                   FontFamily="{DynamicResource ThemeFontFamily}" 
                   FontSize="18"/>
            <Label x:Name="PlayerNameLabel" 
                   TextColor="{DynamicResource ThemeTextColor}" 
                   FontFamily="{DynamicResource ThemeFontFamily}" 
                   FontSize="18" 
                   FontAttributes="Bold"/>
            
            <Label Text="Skoor:" 
                   TextColor="{DynamicResource ThemeTextColor}" 
                   FontFamily="{DynamicResource ThemeFontFamily}" 
                   FontSize="18" 
                   Margin="20,0,0,0"/>
            <Label x:Name="ScoreLabel" 
                   Text="0" 
                   TextColor="{DynamicResource ThemeTextColor}" 
                   FontFamily="{DynamicResource ThemeFontFamily}" 
                   FontSize="18" 
                   FontAttributes="Bold"/>
        </HorizontalStackLayout>

        <Border BackgroundColor="{DynamicResource ThemeGridBackgroundColor}" 
                Padding="10" 
                StrokeShape="RoundRectangle 10"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Grid x:Name="GameGrid" RowSpacing="5" ColumnSpacing="5" />
        </Border>

        <Button Text="Uus mäng" 
                Clicked="OnNewGameClicked"
                BackgroundColor="{DynamicResource ThemeAccentColor}"
                TextColor="{DynamicResource ThemeTextColor}"
                FontFamily="{DynamicResource ThemeFontFamily}"
                HorizontalOptions="Center" />

    </VerticalStackLayout>
</ContentPage>