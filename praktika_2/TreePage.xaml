<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="praktika_2.TreePage">

    <Grid RowDefinitions="*, Auto" Padding="10">
        <Grid Grid.Row="0">

            <!-- Background -->
            <Grid RowDefinitions="3*, 1*">
                <BoxView x:Name="Sky"
                         Grid.Row="0"
                         Color="LightSkyBlue"
                         HorizontalOptions="Fill"
                         VerticalOptions="Fill" />
                
                <AbsoluteLayout HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True">
                    <Border x:Name="Sun"
                            BackgroundColor="#f9dd75"
                            Stroke="Transparent"
                            StrokeThickness="2"
                            WidthRequest="40"
                            HeightRequest="40"
                            IsVisible="False"
                            AbsoluteLayout.LayoutFlags="PositionProportional"
                            AbsoluteLayout.LayoutBounds="0, 1, 40, 40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                    </Border>
                    
                    <Border x:Name="Moon"
                            BackgroundColor="#F0F3F4"
                            Stroke="Transparent"
                            StrokeThickness="2"
                            WidthRequest="34"
                            HeightRequest="34"
                            IsVisible="False"
                            AbsoluteLayout.LayoutFlags="PositionProportional"
                            AbsoluteLayout.LayoutBounds="0, 1, 34, 34">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="17" />
                        </Border.StrokeShape>
                    </Border>
                </AbsoluteLayout>

                <BoxView x:Name="Ground"
                         Grid.Row="1"
                         Color="DarkOliveGreen"
                         HorizontalOptions="Fill"
                         VerticalOptions="Fill" />
            </Grid>

            <!-- Tree graphic -->
            <AbsoluteLayout HorizontalOptions="Fill" VerticalOptions="Fill">

                <BoxView x:Name="Trunk"
                         Color="#75593e"
                         WidthRequest="40"
                         HeightRequest="150"
                         AbsoluteLayout.LayoutFlags="PositionProportional"
                         AbsoluteLayout.LayoutBounds="0.5, 0.80, Autosize, Autosize" />

                <Border x:Name="Canopy"
                        BackgroundColor="#4e753e"
                        Stroke="Transparent"
                        WidthRequest="160"
                        HeightRequest="160"
                        AbsoluteLayout.LayoutFlags="PositionProportional"
                        AbsoluteLayout.LayoutBounds="0.5, 0.40, Autosize, Autosize">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="80" />
                    </Border.StrokeShape>
                </Border>
            </AbsoluteLayout>
            
            <!-- Daytime light/darkness overlay -->
            <BoxView x:Name="DarknessOverlay" 
                     Color="White"
                     Opacity="0.0"
                     InputTransparent="True"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill"
                     IsVisible="False"
                     />
        </Grid>
        
        <!-- Actions manager -->
        <Border Grid.Row="1" StrokeThickness="1" Stroke="#CCCCCC">
            <ScrollView MaximumHeightRequest="320">
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="StatusLabel"
                           Text="Vali tegevus ja vajuta 'Käivita'"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="DarkGreen" />

                    <Grid ColumnDefinitions="2*, 1*, 1*" ColumnSpacing="6">
                        <Picker x:Name="ActionPicker" 
                                Grid.Column="0" 
                                Title="Vali tegevus..." 
                                FontSize="12" 
                                HeightRequest="36">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Kasvata</x:String>
                                    <x:String>Lase õitsema</x:String>
                                    <x:String>Raputa</x:String>
                                    <x:String>Langeta</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>

                        <Button x:Name="RunButton" 
                                Grid.Column="1" 
                                Text="Käivita" 
                                FontSize="12" 
                                HeightRequest="36" 
                                Padding="0"
                                BackgroundColor="#2E7D32" 
                                TextColor="White" 
                                Clicked="OnActionClicked" />

                        <Button x:Name="ResetButton" 
                                Grid.Column="2" 
                                Text="Reset" 
                                FontSize="12" 
                                HeightRequest="36" 
                                Padding="0"
                                BackgroundColor="#616161" 
                                TextColor="White" 
                                Clicked="OnResetClicked" />
                    </Grid>
                    <VerticalStackLayout>
                        <Label x:Name="OpacityValueLabel" Text="Võra läbipaistvus (Opacity): 1.0" FontSize="12" />

                        <Slider x:Name="OpacitySlider"
                                Minimum="0.0"
                                Maximum="1.0"
                                Value="1.0"
                                ValueChanged="OnOpacitySliderValueChanged" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label x:Name="SpeedLabel"
                               Grid.Column="0"
                               Text="Animatsiooni kestus: 1000 ms"
                               VerticalOptions="Center" />

                        <Stepper x:Name="SpeedStepper"
                                 Grid.Column="1"
                                 Minimum="500"
                                 Maximum="2000"
                                 Increment="250"
                                 Value="1000"
                                 ValueChanged="OnSpeedStepperValueChanged" />
                    </Grid>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Aastaaeg / kuupäev:" FontSize="12" />

                            <DatePicker x:Name="VirtualDatePicker"
                                        DateSelected="OnDateOrTimeChanged" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Kellaaeg (Aeg):" FontSize="12" />

                            <TimePicker x:Name="VirtualTimePicker"
                                        PropertyChanged="OnTimePickerPropertyChanged" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>