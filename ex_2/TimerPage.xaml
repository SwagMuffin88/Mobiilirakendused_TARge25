<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ex_2.TimerPage">
    <ContentPage.Content>
        <StackLayout>
            <FlexLayout>
                <Label x:Name="label"
                       Text="Tap this button"
                       FontSize="Medium"
                       BackgroundColor="Gainsboro">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer 
                            Tapped="HandleGestureRecognizerTapped"/>
                    </Label.GestureRecognizers>
                </Label>
                
                <Button x:Name="timer_button"
                        Text="Show info"
                        FontSize="Large"
                        Clicked="HandleTimerButtonOnClicked"
                    />
            </FlexLayout>
            
            <Button x:Name="back"
                    Text="Back"
                    FontSize="Large"
                    Clicked="HandleBackButtonClick"
                />
        </StackLayout>
    </ContentPage.Content>
</ContentPage>